    "lines": [
      {
        "line_id": "line_000083_000066",
        "start": 0,
        "end": 33,
        "text": "No. 703) for the relief of. 2794,"
      }
    ]
  },
  {
    "source_id": "congressionalglo7395unit:529:par_000529_000006",
    "raw_sha256": "7a926169722e128633f476c44c0ade2ba003c51119a83736a05bf7bf7550d426",
    "page_line_sha256": "5a9d247b8023c2844b89028f586aa65bec3e170f24e2a8179de82d8c94fa976f",
    "lines": [
      {
        "line_id": "line_000529_000017",
        "start": 0,
        "end": 39,
        "text": "The Committee on- Appropriations recom-"
      },
      {
        "line_id": "line_000529_000018",
        "start": 40,
        "end": 63,
        "text": "mended non-concurrence."
      }
    ]
  },
  {
    "source_id": "congressionalglo7395unit:1060:par_001060_000025",
    "raw_sha256": "8afdad05fdde58558f1cf5a973e281e1247e086cfad7af139eba0a6dbecacbbf",
    "page_line_sha256": "4fd2d11afff00767ef3bae9ec242b4508f62d52d5edf303959a08c4feaef467d",
    "lines": [
      {
        "line_id": "line_001060_000161",
        "start": 0,
        "end": 42,
        "text": "Sec. 2. And be it further enacted, That in"
      },
      {
        "line_id": "line_001060_000162",
        "start": 43,
        "end": 88,
        "text": "case suits or proceedings are pending in said"
      },
      {
        "line_id": "line_001060_000163",
        "start": 89,
        "end": 132,
        "text": "provisional court which could not have been"
      },
      {
        "line_id": "line_001060_000164",
        "start": 133,
        "end": 182,
        "text": "instituted in said circuit or district court, the"
      },
      {
        "line_id": "line_001060_000165",
        "start": 183,
        "end": 231,
        "text": "record shall remain in said district court with-"
      },
      {
        "line_id": "line_001060_000166",
        "start": 232,
        "end": 259,
        "text": "out further action therein."
      }
    ]
  },
  {
    "source_id": "congressionalglo7395unit:1060:par_001060_000026",
    "raw_sha256": "d3d297fc4b96c5e77591cd5c98530462be7a5a3381ff6cf300a1dfb440e3e411",
    "page_line_sha256": "4fd2d11afff00767ef3bae9ec242b4508f62d52d5edf303959a08c4feaef467d",
    "lines": [
      {
        "line_id": "line_001060_000167",
        "start": 0,
        "end": 43,
        "text": "Sec. 3. And be it further enacted, That all"
      },
      {
        "line_id": "line_001060_000168",
        "start": 44,
        "end": 88,
        "text": "judgments, orders, decrees, and decisions of"
      },
      {
        "line_id": "line_001060_000169",
        "start": 89,
        "end": 132,
        "text": "the United States provisional court for the"
      },
      {
        "line_id": "line_001060_000170",
        "start": 133,
        "end": 182,
        "text": "State of Louisiana, relating to the causes hereby"
      },
      {
        "line_id": "line_001060_000171",
        "start": 183,
        "end": 231,
        "text": "transferred to the district court of the eastern"
      }
    ]
  },
  {
    "source_id": "congressionalglo7395unit:1060:par_001060_000027",
    "raw_sha256": "42f077531ceac77b40857983d727226ea24ac857994913b82909af411e485eb5",
    "page_line_sha256": "4fd2d11afff00767ef3bae9ec242b4508f62d52d5edf303959a08c4feaef467d",
    "lines": [
      {
        "line_id": "line_001060_000172",
        "start": 0,
        "end": 46,
        "text": "district of Louisiana, or to the circuit court"
      },
      {
        "line_id": "line_001060_000173",
        "start": 47,
        "end": 94,
        "text": "held in said district, shall at once become the"
      },
      {
        "line_id": "line_001060_000174",
        "start": 95,
        "end": 139,
        "text": "judgments, orders, decrees, and decisions of"
      },
      {
        "line_id": "line_001060_000175",
        "start": 140,
        "end": 190,
        "text": "said district court, or said circuit court, unless"
      },
      {
        "line_id": "line_001060_000176",
        "start": 191,
        "end": 235,
        "text": "the same are inconsistent with the rules and"
      },
      {
        "line_id": "line_001060_000177",
        "start": 236,
        "end": 277,
        "text": "proceedings thereof; and may be enforced,"
      },
      {
        "line_id": "line_001060_000178",
        "start": 278,
        "end": 324,
        "text": "pleaded, and proved, as the judgments, orders,"
      },
      {
        "line_id": "line_001060_000179",
        "start": 325,
        "end": 373,
        "text": "decrees, or decisions of said district court, or"
      },
      {
        "line_id": "line_001060_000180",
        "start": 374,
        "end": 393,
        "text": "said circuit court."
      },
      {
        "line_id": "line_001060_000181",
        "start": 394,
        "end": 418,
        "text": "Approved, July 28, 1866."
      }
    ]
  },
  {
    "source_id": "congressionalglo7395unit:1060:par_001060_000028",
    "raw_sha256": "38df69ac13782c2367417d4c8807e27539bd6edd36e7c19758163967681efcfc",
    "page_line_sha256": "4fd2d11afff00767ef3bae9ec242b4508f62d52d5edf303959a08c4feaef467d",
    "lines": [
      {
        "line_id": "line_001060_000182",
        "start": 0,
        "end": 41,
        "text": "Chap. CCCXL — An Act to remove tte Office"
      },
      {
        "line_id": "line_001060_000183",
        "start": 42,
        "end": 83,
        "text": "of Surveyor General of the States of Iowa"
      },
      {
        "line_id": "line_001060_000184",
        "start": 84,
        "end": 123,
        "text": "and Wisconsin to Plattsmouth, Nebraska."
      },
      {
        "line_id": "line_001060_000185",
        "start": 124,
        "end": 169,
        "text": "Be it enacted by the Senate and House of Rep-"
      },
      {
        "line_id": "line_001060_000186",
        "start": 170,
        "end": 217,
        "text": "resentatives of the United States of America in"
      },
      {
        "line_id": "line_001060_000187",
        "start": 218,
        "end": 263,
        "text": "Congress assembled, That it shall be the duty"
      },
      {
        "line_id": "line_001060_000188",
        "start": 264,
        "end": 311,
        "text": "of the Secretary of the Interior, as soon after"
      },
      {
        "line_id": "line_001060_000189",
        "start": 312,
        "end": 358,
        "text": "the passage of this act as maybe, to cause the"
      },
      {
        "line_id": "line_001060_000190",
        "start": 359,
        "end": 405,
        "text": "office of surveyor general of Iowa and Wiscon-"
      },
      {
        "line_id": "line_001060_000191",
        "start": 406,
        "end": 450,
        "text": "sin to.be removed to Plattsmouth in the Ter-"
      },
      {
        "line_id": "line_001060_000192",
        "start": 451,
        "end": 496,
        "text": "ritory of Nebraska, and to make the necessary"
      },
      {
        "line_id": "line_001060_000193",
        "start": 497,
        "end": 542,
        "text": "provisions for immediate and effective opera-"
      },
      {
        "line_id": "line_001060_000194",
        "start": 543,
        "end": 585,
        "text": "tions ; and when so removed the duties and"
      },
      {
        "line_id": "line_001060_000195",
        "start": 586,
        "end": 632,
        "text": "jurisdiction of said surveyor general shall be"
      },
      {
        "line_id": "line_001060_000196",
        "start": 633,
        "end": 680,
        "text": "coextensive with the limits of the Territory of"
      },
      {
        "line_id": "line_001060_000197",
        "start": 681,
        "end": 725,
        "text": "Nebraska, and include the State of Iowa, and"
      },
      {
        "line_id": "line_001060_000198",
        "start": 726,
        "end": 773,
        "text": "the same shall constitute a surveying district."
      },
      {
        "line_id": "line_001060_000199",
        "start": 774,
        "end": 817,
        "text": "Sec. 2. And be it further enacted. That all"
      },
      {
        "line_id": "line_001060_000200",
        "start": 818,
        "end": 862,
        "text": "acts and parts of acts inconsistent with the"
      },
      {
        "line_id": "line_001060_000201",
        "start": 863,
        "end": 907,
        "text": "provisions of this act, be, and the same are"
      },
      {
        "line_id": "line_001060_000202",
        "start": 908,
        "end": 925,
        "text": "hereby, repealed."
      },
      {
        "line_id": "line_001060_000203",
        "start": 926,
        "end": 950,
        "text": "Approved, July 28, 1866."
      }
    ]
  },
  {
