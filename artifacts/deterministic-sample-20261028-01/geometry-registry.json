[
  {
    "source_id": "congressionalg7391unit:526:par_000526_000021",
    "raw_sha256": "c2c190f9b6bfed34f956f8603ccb3cf658e6f0a012fcd6cf7ed5d77035cc6cc8",
    "page_line_sha256": "5b183a56e701d8b4bb29f729c69fceb66a45bcc2057add9e5e21c8d911376e81",
    "lines": [
      {
        "line_id": "line_000526_000237",
        "start": 0,
        "end": 44,
        "text": "We have now, as I believe, the golden oppor-"
      },
      {
        "line_id": "line_000526_000238",
        "start": 45,
        "end": 93,
        "text": "tunity to remedy this evil which will never come"
      },
      {
        "line_id": "line_000526_000239",
        "start": 94,
        "end": 139,
        "text": "again to the men of this generation. The sys-"
      },
      {
        "line_id": "line_000526_000240",
        "start": 140,
        "end": 183,
        "text": "tem of slavery has fallen. The States whose"
      },
      {
        "line_id": "line_000526_000241",
        "start": 184,
        "end": 229,
        "text": "representation was increased by it have, with"
      },
      {
        "line_id": "line_000526_000242",
        "start": 230,
        "end": 278,
        "text": "two or three exceptions, destroyed their loyal '"
      },
      {
        "line_id": "line_000526_000243",
        "start": 279,
        "end": 320,
        "text": "and legal State governments, and now seek"
      },
      {
        "line_id": "line_000526_000244",
        "start": 321,
        "end": 360,
        "text": "reconstruction. The committee on recon-"
      },
      {
        "line_id": "line_000526_000245",
        "start": 361,
        "end": 404,
        "text": "struction having reported this amendment, I"
      },
      {
        "line_id": "line_000526_000246",
        "start": 405,
        "end": 452,
        "text": "infer that they will, if this amendment is sub-"
      },
      {
        "line_id": "line_000526_000247",
        "start": 453,
        "end": 498,
        "text": "mitted to the State Legislatures by Congress,"
      },
      {
        "line_id": "line_000526_000248",
        "start": 499,
        "end": 547,
        "text": "recommend that its adoption by the States lately"
      },
      {
        "line_id": "line_000526_000249",
        "start": 548,
        "end": 595,
        "text": "in rebellion be one of the guarantees to be in-"
      },
      {
        "line_id": "line_000526_000250",
        "start": 596,
        "end": 641,
        "text": "sisted upon as a condition precedent to their"
      },
      {
        "line_id": "line_000526_000251",
        "start": 642,
        "end": 686,
        "text": "taking equal authority and rank in the Union"
      },
      {
        "line_id": "line_000526_000252",
        "start": 687,
        "end": 709,
        "text": "with the loyal States."
      }
    ]
  },
  {
    "source_id": "congressionalglo7392unit:716:par_000716_000020",
