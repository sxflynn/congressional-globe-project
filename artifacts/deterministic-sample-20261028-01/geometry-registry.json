    "lines": [
      {
        "line_id": "line_000716_000101",
        "start": 0,
        "end": 39,
        "text": "Mr. BROWN. The navigable channel is not"
      },
      {
        "line_id": "line_000716_000102",
        "start": 40,
        "end": 58,
        "text": "private propei-ty."
      }
    ]
  },
  {
    "source_id": "congressionalglo7393unit:1055:par_001055_000071",
