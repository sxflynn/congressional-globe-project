[{"source_id": "congressionalglo7392unit:1051:par_001051_000014", "raw_sha256": "5e171ba3d1a69369966ffed0b12fb53bad892284746c46c675cfbf43508101d6", "page_line_sha256": "c1e57b3a20fa5085847f780a52569e4b935eb938b2769c7d27161d86e9a1d915", "lines": [{"line_id": "line_001051_000086", "start": 0, "end": 40, "text": "Mr. KASSON. It seems to me that it would"}, {"line_id": "line_001051_000087", "start": 41, "end": 88, "text": "be better to follow our old practice, according"}, {"line_id": "line_001051_000088", "start": 89, "end": 137, "text": "to which, on the admission of those Territories,"}, {"line_id": "line_001051_000089", "start": 138, "end": 181, "text": "Congress declares the terms upon which they"}, {"line_id": "line_001051_000090", "start": 182, "end": 228, "text": "are to be received, giving them certain grants"}, {"line_id": "line_001051_000091", "start": 229, "end": 274, "text": "of land in order to place them on an equality"}, {"line_id": "line_001051_000092", "start": 275, "end": 307, "text": "with States previously admitted."}]}]