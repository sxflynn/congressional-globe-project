[{"source_id": "congressionalglo7392unit:406:par_000406_000009", "raw_sha256": "b751536c19095f11a11e40f5013f527087980bdbdec887729ce7715c0e48ef4f", "page_line_sha256": "529a1424cb5378f461ba024a5d21174c66ac789f9a1fd513a7b34be7bf24be81", "lines": [{"line_id": "line_000406_000032", "start": 0, "end": 39, "text": "Mr. VAN WINKLE. I will state that there"}, {"line_id": "line_000406_000033", "start": 40, "end": 83, "text": "must be a mistake in the name. This case of"}, {"line_id": "line_000406_000034", "start": 84, "end": 126, "text": "Anderson's was considered in the committee"}, {"line_id": "line_000406_000035", "start": 127, "end": 172, "text": "under the supposition that it was the same as"}, {"line_id": "line_000406_000036", "start": 173, "end": 211, "text": "the case of the person called Johnson."}]}]