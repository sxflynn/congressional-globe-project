[{"source_id": "congressionalglo7393unit:988:par_000988_000008", "raw_sha256": "6cac378db04e18b31c4d682c3c8bd7b2e9bae40b5102cb086b543f2f48a226a9", "page_line_sha256": "4cc9aef972b5faf2049641947a3efd1e7dd9b38d602b6806b68d2ddf5439edc3", "lines": [{"line_id": "line_000988_000054", "start": 0, "end": 38, "text": "The PRESIDENT pro tempore. It is moved"}, {"line_id": "line_000988_000055", "start": 39, "end": 82, "text": "and seconded that the Senator from Illinois"}, {"line_id": "line_000988_000056", "start": 83, "end": 127, "text": "be authorized to withdraw from the Committee"}, {"line_id": "line_000988_000057", "start": 128, "end": 173, "text": "on Military Affairs the petition presented by"}, {"line_id": "line_000988_000058", "start": 174, "end": 218, "text": "him which was referred to that, committee by"}, {"line_id": "line_000988_000059", "start": 219, "end": 255, "text": "order of the Senate some time since."}]}]