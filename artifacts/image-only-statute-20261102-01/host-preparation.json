      {
        "alias": "P8",
        "source_id": "congressionalglo7395unit:741:par_000741_000007",
        "part_number": 5,
        "scan_leaf": 741,
        "role": "target",
        "raw": {
          "text": "\"Sec. 13. And he it further enacted. That the Presi- dent is hereby .authorized, at any time hereafter, by proclamation, to extend to persons who may have participated in the existing rebellion in any State or part thereof, pardon and amnesty, with such excep- tions and at such time and on such conditions as he may deem expedient for the public welfare.\"",
          "sha256": "b4f4cd8ccce9ffb5f813c7435c7ff3cff6b6056c74c42378c418b40a9e01821b"
        },
        "static": {
          "text": "\"Sec. 13. And he it further enacted. That the President is hereby .authorized, at any time hereafter, by proclamation, to extend to persons who may have participated in the existing rebellion in any State or part thereof, pardon and amnesty, with such exceptions and at such time and on such conditions as he may deem expedient for the public welfare.\"",
          "sha256": "e126433fd4a404760fb5aafa4a1cf6593288e8a1c8e639ea4a0d3baf745ef811",
