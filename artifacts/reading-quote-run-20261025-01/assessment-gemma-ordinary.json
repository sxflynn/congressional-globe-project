          "clean_end": 625,
          "kind": "unchanged"
        }
      ],
      "uncertain": [],
      "status": "model_proposal"
    },
    "congressionalg7391unit:576:par_000576_000038": {
      "text": "Resolved, That the Committee on Indian Affairs be instructed to inquire into the justice and propriety of reporting a bill providing for the appointment of a commissioner, whose duty it shall be to determine the amount of depredations by said Indians upon the citizens of said Territory, and of recommending an appropriation sufficient to pay the same.",
