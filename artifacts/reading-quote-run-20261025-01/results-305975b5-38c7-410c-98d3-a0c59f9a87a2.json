        "congressionalg7391unit:576:par_000576_000036": {
          "text": "Mr. BURLEIGH, by unanimous consent, submitted the following preamble and resolution ; which were read, considered, and agreed to :",
          "sha256": "baf0a8be7b26eacfe96bf1083a23a4a837fc2f9674d6c49edd4ae6933d4ae582",
          "raw_sha256": "ba222fec07e37c0c169da4eab2930616762bec2b2950a27177bbab5582b4baf5",
