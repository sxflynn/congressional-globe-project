        "congressionalglo7395unit:330:par_000330_000021": {
          "text": "Mr. VAN AERNAM, from the Committee on Invalid Pensions, reported a bill for the relief of Francis Colgen.; which was read a first and second time.",
          "sha256": "1a271b7be4fa9e77550f8b53b39f8444560e014376d828790eea4cb961e02fd5",
          "raw_sha256": "1a271b7be4fa9e77550f8b53b39f8444560e014376d828790eea4cb961e02fd5",
          "mapping": [
