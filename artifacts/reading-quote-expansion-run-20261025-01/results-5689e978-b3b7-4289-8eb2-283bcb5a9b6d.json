        "congressionalg7391unit:207:par_000207_000039": {
          "text": "One of these is entitled \"A bill supplying appropriate legislation to enforce the amend- ment of the Constitution.\" From this bill I read two sections :",
          "sha256": "3afe7683cfba94882c2236d17cd2e335577353994c260c3e8ee6738b7533adde",
          "raw_sha256": "3afe7683cfba94882c2236d17cd2e335577353994c260c3e8ee6738b7533adde",
          "mapping": [
            {
              "raw_start": 0,
              "raw_end": 152,
              "clean_start": 0,
              "clean_end": 152,
              "kind": "unchanged"
            }
          ],
          "uncertain": [
            {
              "source_id": "congressionalg7391unit:207:par_000207_000039",
              "start": 0,
              "end": 152,
              "reason": "Missing images to verify text."
            }
          ],
          "status": "model_proposal"
        },
        "congressionalg7391unit:207:par_000207_000040": {
          "text": "Sec. 3. And be it furilier enacted. That in further enforcement of the provision of the Constitution pro- hibiting slavei-y, and in order to remove all relics of this wrong from the States where this constitutional prohibition takes effect, it is hereby declared that all laws or customs in such States establishing any oli- garchical privileges and any distinction of rights on account of color or race arc hereby annulled, and all persons in such States are recognized as equal be- fore the law; and the penalties provided in the last section arc hereby made applicable to any violation of this provision, which is made in pursuance of the Constitution of the United States.",
          "sha256": "bc6151d6157b4d29fdce9ed755e45533d17650f5643afe7ecaf9c185c442d9d9",
          "raw_sha256": "bc6151d6157b4d29fdce9ed755e45533d17650f5643afe7ecaf9c185c442d9d9",
          "mapping": [
