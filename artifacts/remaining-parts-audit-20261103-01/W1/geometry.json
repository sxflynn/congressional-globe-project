[{"source_id": "congressionalg7391unit:150:par_000150_000094", "raw_sha256": "0ed67d2d214dcc5408f71965c2c8a7cc327aaa2a0ead8c06838d188b46cbb6f6", "page_line_sha256": "185132ca0504843c65d732c299f49fb968c6a371a2d3f497ccf402cfb8031bd1", "lines": [{"line_id": "line_000150_000263", "start": 0, "end": 38, "text": "Mr. GRIMES. I object to the reading of"}, {"line_id": "line_000150_000264", "start": 39, "end": 85, "text": "that paper. It is not addressed to the Senate."}, {"line_id": "line_000150_000265", "start": 86, "end": 131, "text": "It seems it is addressed to Jacob Barker, and"}, {"line_id": "line_000150_000266", "start": 132, "end": 177, "text": "presented here to influence the action of the"}, {"line_id": "line_000150_000267", "start": 178, "end": 185, "text": "Senate."}]}]