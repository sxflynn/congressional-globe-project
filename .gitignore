# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
.streamlit/secrets.toml
artifacts/
*.partial
*.interrupted

# Disposable scratch and POC outputs; retain the directory marker.
/tmp/*
!/tmp/.gitkeep

.playwright-mcp/*
# Downloaded immutable Internet Archive sources; keep only the directory marker.
/downloads/*
!/downloads/.gitkeep

